  "bb:web_validation": {
    "validator": "agentic-web",
    "checked": "2026-07-06",
    "confidence": "HIGH",
    "root_cause": "The smiles_code field in the chemlists table was ~97% null (30/1000 rows, ~3%). Root cause is NOT a build/parse bug: CEBS (NIEHS/NTP Chemical Effects in Biological Systems) is an assay-/study-centric resource that keys chemicals by CASRN, DTXSID and chemical name; its source chemlists dataset supplies SMILES for only ~3% of chemicals. Structures are genuinely sparse in the source. Identifiers ARE nearly complete: dtt_casrn 100%, dtxsid 99.6%, epa_cas_no 99.6%, chemical names ~100%.",
    "resolution": "genuinely-sparse -> enriched",
    "enrichment": {
      "date": "2026-07-06",
      "field": "smiles_code",
      "table": "brick/datasets/chemlists.parquet",
      "description": "Backfilled the sparse smiles_code field by mapping the identifiers present in CEBS (DTXSID primary, CASRN fallback) to InChI via the local DSSTox table, then InChI -> RDKit canonical SMILES. Source-provided SMILES preserved as-is; only null cells filled. Implemented as stages/04_enrich_smiles.py and wired into the fetch stage.",
      "mapping_sources": [
        "comptox/brick/dsstox_identifiers.parquet (DSSTox DTXSID/CASRN -> InChI -> canonical SMILES via RDKit)"
      ],
      "rows_total": 1000,
      "rows_with_smiles_before": 30,
      "rows_with_smiles_after": 951,
      "row_fill_rate_before": 0.03,
      "row_fill_rate_after": 0.951,
      "distinct_chemicals": 458,
      "chemicals_with_smiles_after": 438,
      "chemical_fill_rate_after": 0.956,
      "smiles_valid_fraction_sampled": 0.996,
      "unresolved_note": "The 49 rows (20 distinct chemicals) still lacking SMILES are predominantly mixtures / UVCB / commercial formulations for which DSSTox has no single defined structure (e.g. Tricresyl phosphate, Firemaster 550, Crude MCHM, Benzalkonium chloride, isopropylated-phenol phosphate)."
    },
    "notes": "Lead confirmed as genuinely-sparse-in-source (not a build defect) and resolved by DSSTox enrichment: smiles_code raised from 3.0% -> 95.1% of rows (95.6% of distinct chemicals), 99.6% RDKit-parseable. The only remaining bb_validate WARN (animal-studies-neonicotinoid-exposure duplicate-row fraction) is pre-existing and unrelated to this lead."
  }
}